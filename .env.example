OWNER_PASSWORD=replace-with-a-long-random-password
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
MODEL_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
