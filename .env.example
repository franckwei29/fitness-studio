COOKIE_SECURE=false
# Optional explicit redacted operational snapshots. Raw graph tracing stays disabled.
STUDIO_LANGSMITH_EXPORT_ENABLED=false
STUDIO_LANGSMITH_API_KEY=
STUDIO_LANGSMITH_ENDPOINT=https://api.smith.langchain.com
STUDIO_LANGSMITH_PROJECT=fitness-studio-redacted
